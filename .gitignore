# Runtime state of a checkout deployment. The app resolves these paths against
# the config file (config.py _find_config): the repo root in a checkout, or the
# directory of a config.json that lives elsewhere (data/). config.json.tmp and
# update_state.json.tmp are the atomic-write temp files.
/config.json
/config.json.tmp
update_state.json
update_state.json.tmp
youtube_token.json
/cloudflared/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/
*.pyc
*.pyo
*.pyd
.tz
/recordings/
/chat/
*.chat.json
*.chat.json.tmp
*:Zone.Identifier
client_secret*.json
credentials*.json
.venv/
*.bak
# Deployment settings (docs/running.md). No .env template ships with the repo.
.env
.env.*
.DS_Store
*.log
.coverage
htmlcov/
