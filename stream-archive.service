[Unit]
Description=StreamArchive - Twitch monitor & recorder
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/stream-archive
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=%h
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/.local/bin/uv run stream-archive
StandardOutput=journal
StandardError=journal
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
