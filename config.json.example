{
    "telegram_user_id": "<your_telegram_user_id>",
    "bot_telegram_api": "<your_bot_api_token>",
    "twitch_client_id": "<your_twitch_client_id>",
    "twitch_client_secret": "<your_twitch_client_secret>",
    "channels": ["twitch:channel1", "twitch:channel2"],
    "proxy_list": [
        "httpproxy://firefox.api.cdn-perfprod.com:2023",
        "httpproxy://chromium.api.cdn-perfprod.com:2023",
        "https://eu2.luminous.dev",
        "https://eu.luminous.dev",
        "https://lb-eu3.cdn-perfprod.com"
    ],
    "monitoring_interval": 60,
    "timezone": "America/New_York",
    "plugin_dir": "/app/plugins",
    "recording_dir": "recordings",
    "record_chat": true,
    "chat_dir": "chat",
    "output_mode": "disk",
    "channel_output_modes": {},
    "channel_youtube_hold_seconds": {},
    "eventsub": {
        "enabled": true
    },
    "kick": {
        "client_id": "<your_kick_client_id>",
        "client_secret": "<your_kick_client_secret>",
        "record_chat": true,
        "webhook": {
            "enabled": false,
            "listen_host": "127.0.0.1",
            "listen_port": 8787,
            "public_url": "https://kick-webhook.example.com/kick/webhook",
            "setup_notified": false,
            "tunnel": "",
            "cloudflare_token": "",
            "cloudflare_managed": false
        }
    },
    "retention_days": 0,
    "preferred_quality": "best",
    "max_concurrent_recordings": 0,
    "max_concurrent_youtube_streams": 0,
    "disk": {
        "max_total_gb": 0,
        "check_interval_s": 60,
        "delete_oldest": true
    },
    "update_check": {
        "enabled": true,
        "interval_hours": 24,
        "check_app": true,
        "check_streamlink": true,
        "check_plugin": true
    },
    "youtube": {
        "privacy_status": "unlisted",
        "client_secrets_file": "client_secret.json",
        "hold_seconds": 0
    }
}
